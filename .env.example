# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — get from resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Site
NEXT_PUBLIC_SITE_URL=https://midwestinvestorservices.com

# Admin email — where deal/contact notifications go
ADMIN_EMAIL=info@midwestinvestorservices.com
DEALS_EMAIL=deals@midwestinvestorservices.com

# Client onboarding (Nextcloud + LibreSign) — see supabase/migrations/004_onboarding.sql
# The account the website uses to store client files and send signature requests
NEXTCLOUD_URL=https://nextcloud.midwestinvestorservices.com
NEXTCLOUD_USER=mis-signing
NEXTCLOUD_APP_PASSWORD=app-password-for-that-account
# Your own Nextcloud username; MIS countersigns after the client
MIS_SIGNER_ACCOUNT=your-nextcloud-username
# Optional: folder (in the signing account) that holds client folders
# ONBOARDING_FOLDER=MIS Clients
# Optional: key for link tokens and LibreSign callbacks (defaults to the service role key)
# ONBOARDING_SECRET=

# Optional: send site email through an SMTP server instead of Amazon SES.
# When SMTP_HOST is set, SES is not used.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Midwest Investor Services <info@midwestinvestorservices.com>
