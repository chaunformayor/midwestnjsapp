# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS SES v2 — the sending domain/identity must be verified in the SES console
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key

# Site
NEXT_PUBLIC_SITE_URL=https://midwestinvestorservices.com

# Admin email — where deal/contact notifications go
ADMIN_EMAIL=info@midwestinvestorservices.com
DEALS_EMAIL=deals@midwestinvestorservices.com
